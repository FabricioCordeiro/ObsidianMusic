@page "/"

<MudPaper Elevation="4">

    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
        🔍 Pesquisar Músicas
    </MudText>

    <MudTextField T="string" Placeholder="Digite o nome da música ou artista..."
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="w-100"
                  InputType="InputType.Search" />

    <MudDivider Class="my-4" />

    <MudList Dense="true" T="string">
        <MudListItem>
            <MudAvatar Icon="@Icons.Material.Filled.MusicNote" Color="Color.Primary" />
            <MudText Class="ml-2">Imagine Dragons - Believer</MudText>
        </MudListItem>
        <MudListItem>
            <MudAvatar Icon="@Icons.Material.Filled.MusicNote" Color="Color.Secondary" />
            <MudText Class="ml-2">The Weeknd - Blinding Lights</MudText>
        </MudListItem>
        <MudListItem>
            <MudAvatar Icon="@Icons.Material.Filled.MusicNote" Color="Color.Tertiary" />
            <MudText Class="ml-2">Arctic Monkeys - Do I Wanna Know?</MudText>
        </MudListItem>
    </MudList>
</MudPaper>